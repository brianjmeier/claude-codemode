[51.634712, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GWaiting for \u001b[1m1\u001b[22;39m background agent to finish\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m\u203a Message from @Explore (ctrl+o to expand)\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u23fa\u001b[39m \u001b[1mprs has the most tests:\u001b[22;39m 30 test files\u001b[41Gand\u001b[45Gabout\u001b[51G645\u001b[55Gtest\u001b[60Gcases.\u001b[67GThat's\u001b[74Groughly\u001b[82G1.8\u001b[86Gtimes\u001b[92Gworkers,\r\u001b[2C\u001b[1Bwhich\u001b[9Gcomes\u001b[15Gsecond\u001b[22Gwith\u001b[27G359.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502 Station\u001b[13G\u2502\u001b[15GTest\u001b[20Gfiles\u001b[26G\u2502\u001b[28GTest\u001b[33Gcases\u001b[39G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 prs     \u2502 30       \u001b[25G \u2502 645        \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 workers \u2502 25 \u001b[19G     \u001b[25G \u2502 359  \u001b[34G     \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500"]
