[37.126469, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m  \u001b[36mtend\u001b[38;5;246m \u001b[38;5;244m|\u001b[22;39m \u001b[32mmain\u001b[39m\u001b[K\r\u001b[1B  \u001b[32m7%\u001b[38;5;246m ctx \u001b[38;5;244m|\u001b[22;39m \u001b[33m$0.00\u001b[38;5;246m \u001b[38;5;244m|\u001b[22;39m \u001b[38;5;244m[Opus 5.5]\r\u001b[1B\u001b[22;39m\u001b[39m  \u001b[38;5;220m\u23f5\u23f5 auto mode on\u001b[38;5;246m (shift+tab to cycle) \u00b7 \u2190 for agents\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[1m  \u23fa main\u001b[22;39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u25ef Explore\u001b[39m  \u001b[38;5;246mIn /Users/bri\u001b[28Gnmeier/dev/tend/exampl\u001b[51Gs/\u001b[137G0s\u001b[39m\u001b[45;1H\u001b[38;3H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[15C\u001b[34B\u001b[38;5;246m16s \u00b7 \u2193\u001b[39m \u001b[38;5;246m911 tokens)\u001b[39m\u001b[K\u001b[45;1H\u001b[38;3H\u001b[?25h"]
