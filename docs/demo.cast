[52.66339, "o", "\u001b[?25l\u001b[H\u001b[5Gprs       \u001b[21G30  \u001b[26G     \u001b[34G645 \u001b[39G     \r\u001b[4C\u001b[2Bworkers\u001b[21G25\u001b[34G359\r\u001b[4C\u001b[2Bbac\u001b[9Glog\u001b[22G0\u001b[35G14\r\u001b[4C\u001b[2Bp\u001b[7Gntry \u001b[21G4 \u001b[34G4\u001b[36G \r\u001b[4C\u001b[2Bs\u001b[7Gfet\u001b[21G5\u001b[35G0\r\u001b[4C\u001b[2Bretrospective\u001b[21G4\u001b[34G38\r\u001b[4C\u001b[2Bupkeep       \u001b[21G2\u001b[34G26\r\u001b[4C\u001b[2Btunn\u001b[10Gls\u001b[21G3\u001b[34G7 \r\u001b[4C\u001b[2Bshells \u001b[21G0\u001b[34G0\r\u001b[2C\u001b[1B\u2514\u001b[19G\u2534\u001b[32G\u2534\u001b[45G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe subagent counted each \u001b[38;5;153mtest(\u001b[39m or \u001b[38;5;153mit(\u001b[39m call,\u001b[48Gso\u001b[51Gthe\u001b[55Gcase\u001b[60Gnumbers\u001b[68Gare\u001b[72Gapproximate.\u001b[85GA\u001b[87G\u001b[38;5;153mtest.each\r\u001b[2C\u001b[1B\u001b[39mtable\u001b[9Gcounts\u001b[16Gonce\u001b[21Grather\u001b[28Gthan\u001b[33Gonce\u001b[38Gper\u001b[42Grow.\u001b[47GThe\u001b[51Granking\u001b[59Gis\u001b[62Gclear\u001b[68Gexcept\u001b[75Gfor\u001b[79Gpantry,\u001b[87Gsafety\u001b[94Gand\r\u001b[2C\u001b[1Bretrospective, which\u001b[24Gare within\u001b[35G3 cases of each\u001b[51Gother.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[30;1H\u001b[26;3H\u001b[?25h"]
